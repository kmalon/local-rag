{
  "realm": "local-rag",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "rag_admin", "description": "Full access: ingestion and query" },
      { "name": "rag_user", "description": "Read access: query only" },
      { "name": "rag_mcp_user", "description": "MCP access: query via the MCP server" }
    ]
  },
  "clients": [
    {
      "clientId": "rag-api-client",
      "description": "REST API callers. Confidential: token exchange requires the client secret, so a process that merely knows this client_id cannot mint a `rag-platform` token. Cannot reach the MCP server either — `rag-mcp-api` is absent from its scope list.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "__RAG_API_CLIENT_SECRET__",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:*", "http://127.0.0.1:*"],
      "webOrigins": ["+"],
      "protocol": "openid-connect",
      "defaultClientScopes": ["roles"],
      "optionalClientScopes": ["rag-api"]
    },
    {
      "clientId": "rag-mcp-client",
      "description": "AI agents reaching the MCP server. Necessarily public — an agent cannot keep a secret — so isolation rests entirely on the scope split: `rag-api` is absent from its scope list, hence no token it obtains can carry the `rag-platform` audience.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:*", "http://127.0.0.1:*"],
      "webOrigins": ["+"],
      "protocol": "openid-connect",
      "defaultClientScopes": ["roles"],
      "optionalClientScopes": ["rag-mcp-api"]
    }
  ],
  "clientScopes": [
    {
      "name": "roles",
      "description": "OpenID Connect scope for add user roles to the access token. Declared here, not inherited.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${rolesScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "user.attribute": "foo",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "client roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "user.attribute": "foo",
            "claim.name": "resource_access.${client_id}.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience resolve",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-resolve-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "rag-api",
      "description": "Access to the REST API; adds the shared platform audience, valid across platform APIs. Assigned to `rag-api-client` only.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "rag-platform-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "rag-platform",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "rag-mcp-api",
      "description": "Access to the MCP server; adds an MCP-only audience so the token is useless elsewhere. Assigned to `rag-mcp-client` only.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "mcp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "rag-mcp",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "Admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@local-rag.test",
      "firstName": "Rag",
      "lastName": "Admin",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "__RAG_ADMIN_PASSWORD__", "temporary": false }
      ],
      "realmRoles": ["rag_admin", "rag_user", "rag_mcp_user"]
    },
    {
      "username": "User",
      "enabled": true,
      "emailVerified": true,
      "email": "user@local-rag.test",
      "firstName": "Rag",
      "lastName": "User",
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "__RAG_USER_PASSWORD__", "temporary": false }
      ],
      "realmRoles": ["rag_user", "rag_mcp_user"]
    }
  ]
}
